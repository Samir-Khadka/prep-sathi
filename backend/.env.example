# Copy to .env for local development. Never commit a real .env.
# Local default is SQLite (prepsathi.db). For production set this to a
# Postgres URL (for example a free Neon database).
DATABASE_URL=sqlite:///./prepsathi.db
# Long random string in production. The code default is a dev placeholder.
PREPSATHI_JWT_SECRET=dev-only-placeholder-change-me-in-production
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
